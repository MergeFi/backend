# ---------------------------------------------------------------------------
# MergeFi Backend — Environment Configuration
# Copy this file to `.env` and fill in real values for local development.
#
# When NODE_ENV=production the app refuses to start unless every one of
# JWT_SECRET, DATABASE_URL, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
# GITHUB_WEBHOOK_SECRET, ESCROW_CONTRACT_ID and TREASURY_SECRET is set to a
# real (non-default, non-empty) value — see src/config/validate-required-config.ts.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of this API, used to build OAuth callback / webhook URLs
APP_URL=http://localhost:4000
# Frontend URL, used for CORS + OAuth redirect back to the SPA
FRONTEND_URL=http://localhost:3000

# Express proxy trust setting. Keep false when Node is directly exposed (as in
# this repository's Docker Compose setup). Behind a single trusted ingress use
# 1; for known proxy ranges, provide a comma-separated subnet/address list.
# Do not use true: it trusts client-supplied forwarding headers.
TRUST_PROXY=false

# --- Database (PostgreSQL via TypeORM) ----------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mergefi
# Set to true only for local bootstrapping; use migrations in production
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# --- Auth / JWT ----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- GitHub OAuth (login) -------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=mock_client_id_12345
GITHUB_CLIENT_SECRET=mock_secret_key_67890

GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# --- GitHub App / REST sync (Octokit) -------------------------------------
# Personal access token or GitHub App installation token used for repo sync.
# TODO: migrate to a GitHub App installation token flow for multi-org support.
GITHUB_API_TOKEN=

# Comma-separated list of exact `owner/repo` names (case-insensitive, no
# wildcards, whitespace around entries ignored) that a MAINTAINER may sync for
# the first time. Repositories already tracked in the database are governed by
# their assigned maintainer instead, so this only gates *new* repos.
# Unset/empty: every first-time sync of an untracked repository is refused
# with 403 (see src/auth/guards/repo-scope.guard.ts).
# Example: GITHUB_SYNC_ALLOWED_REPOS=MergeFi/backend,MergeFi/frontend
GITHUB_SYNC_ALLOWED_REPOS=

# --- GitHub Webhooks -------------------------------------------------------
# Secret configured on the GitHub repo/organization webhook. Used to verify
# the `X-Hub-Signature-256` HMAC-SHA256 header on every incoming webhook.
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# --- Stellar / Soroban -----------------------------------------------------
# "testnet" | "futurenet" | "mainnet"
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase must match STELLAR_NETWORK; testnet default shown.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# mergefi-contracts is deployed to Stellar testnet; see that repo's README
# for the current contract IDs.
#
# DRY-RUN MODE: if ESCROW_CONTRACT_ID *or* TREASURY_SECRET is blank, every
# escrow call (fund/release/refund/withdraw) is faked: no transaction is
# submitted, yet escrows still go LOCKED/RELEASED, Payment rows are written
# as CONFIRMED and bounties move to PAID. Those records carry a synthetic
# tx hash of the form `dry-run-<method>-<timestamp>` — NOTHING SETTLED.
# Both values are blank below, so a fresh copy of this file runs in dry-run.
# See README "Dry-run mode".
ESCROW_CONTRACT_ID=
# Optional separate contract for maintenance-pool escrows; falls back to
# ESCROW_CONTRACT_ID when unset. EscrowService targets this for pool
# fund/release/refund calls (#157).
MAINTENANCE_POOL_CONTRACT_ID=

# Soroban token (SAC) contract addresses for each supported asset. Passed as
# the required `token` argument to escrow::fund (#158). Leave blank when no
# contracts are deployed (calls dry-run regardless).
USDC_TOKEN_CONTRACT_ID=
XLM_TOKEN_CONTRACT_ID=
# Fallback escrow deadline (seconds from fund time) used as escrow::fund's
# `deadline` argument when the funding bounty/milestone has none of its own.
# Default: 7776000 (90 days).
#
# This is NOT local bookkeeping. On-chain, once now >= deadline +
# GRACE_PERIOD (14 days), escrow::refund becomes PERMISSIONLESS: anyone can
# trigger it and the funds return to the funders, even though this backend
# still treats the bounty as live. A short value shortens that window for
# every bounty without its own deadline — e.g. 604800 (7 days) lets a third
# party unwind it from day 21. Must be an integer >= 86400 (1 day); the app
# refuses to boot otherwise. See README "ESCROW_DEADLINE_SECONDS".
ESCROW_DEADLINE_SECONDS=7776000

# Treasury / platform account that pays transaction fees and can act as a
# fallback signer for automated (non-custodial) release/refund operations.
# Leaving this blank also puts escrow calls in dry-run mode (see above).
# TODO: replace with a proper signing service (KMS / multi-sig) before
# handling real funds.
TREASURY_SECRET=

# --- Analytics ---------------------------------------------------------
# In-process TTL (ms) for GET /analytics/platform. Also invalidated when a
# bounty is created/paid or a repository is first synced. Default 60000.
# Per-process: multi-instance deploys may serve up to one TTL of stale data.
ANALYTICS_PLATFORM_SUMMARY_TTL_MS=60000

# --- Schedulers ----------------------------------------------------------
# Whether this process runs the hourly cron sweeps (bounty deadline expiry and
# expired idempotency-key cleanup). Unset or any other value: enabled.
# `false`, `0`, `no` or `off` (case-insensitive): disabled. When running
# separate web and worker tiers, set this to `false` on the web replicas and
# leave it unset on the worker. Postgres advisory locks keep concurrent
# replicas from double-running a sweep, but every replica still wakes up.
RUN_SCHEDULERS=true

# --- Misc --------------------------------------------------------------
# NestJS log verbosity: error | warn | log | debug | verbose
LOG_LEVEL=debug

# AES-256-GCM key (64 hex chars = 32 bytes) used to encrypt stored GitHub
# tokens at rest. Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=64a2f98b7e3c1d5e6f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e


# Production API docs: set to "user:password" to serve /api/docs behind HTTP Basic
# auth. Unset in production means the docs are not served (#809).
# SWAGGER_BASIC_AUTH=
